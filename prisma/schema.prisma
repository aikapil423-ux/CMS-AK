datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UnitType {
  HQ
  RANGE
  COMMISSIONERATE
  DISTRICT
  SUB_DIVISION
  POLICE_STATION
  POLICE_POST
}

enum PoliceRank {
  CONSTABLE
  HEAD_CONSTABLE
  ASSISTANT_SUB_INSPECTOR
  SUB_INSPECTOR
  INSPECTOR
  DEPUTY_SP
  ADDITIONAL_SP
  SUPERINTENDENT_OF_POLICE
  INSPECTOR_GENERAL
  ADGP
  DGP
}

enum SystemRole {
  SUPER_ADMIN
  SP_DISTRICT
  DSP_SUBDIV
  SHO
  MHC_GD_INCHARGE
  DUTY_OFFICER
  ENQUIRY_OFFICER
  READER_TO_SHO
  VIEWER_AUDITOR
}

enum UserStatus {
  ACTIVE
  TRANSFERRED
  SUSPENDED
  LEAVE
  RETIRED
}

model PoliceUnit {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  type         UnitType
  district     String
  range        String
  contactPhone String?
  email        String?
  address      String?
  parentId     String?
  parent       PoliceUnit?         @relation("UnitHierarchy", fields: [parentId], references: [id])
  subUnits     PoliceUnit[]        @relation("UnitHierarchy")
  officers     User[]
  complaints   Complaint[]
  gdEntries    GeneralDiaryEntry[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([district])
  @@index([type])
}

model User {
  id                 String              @id @default(cuid())
  pno                String              @unique
  beltNumber         String?
  fullName           String
  rank               PoliceRank
  role               SystemRole
  status             UserStatus          @default(ACTIVE)
  mobileNumber       String              @unique
  email              String?             @unique
  passwordHash       String
  unitId             String
  unit               PoliceUnit          @relation(fields: [unitId], references: [id])
  assignedComplaints Complaint[]         @relation("AssignedEO")
  registeredComplaints Complaint[]       @relation("RegisteredBy")
  assignedByMe       Complaint[]         @relation("AssignedBy")
  enquiryActions     EnquiryActionLog[]
  submittedReports   EnquiryReport[]
  approvalDecisions  ApprovalHistory[]
  gdEntriesLogged    GeneralDiaryEntry[] @relation("GDLogger")
  auditLogs          AuditLog[]
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([unitId])
  @@index([role])
}

enum ComplaintSource {
  WALK_IN_STATION
  CM_WINDOW_HARYANA
  CITIZEN_PORTAL_HARPATH
  EMERGENCY_112
  SP_OFFICE_REFERENCE
  POSTAL_APPLICATION
  WOMEN_HELPLINE
  SENIOR_CITIZEN_DESK
}

enum ComplaintCategory {
  CYBER_CRIME
  PROPERTY_THEFT_BURGLARY
  FINANCIAL_FRAUD_CHEATING
  LAND_PROPERTY_DISPUTE
  PHYSICAL_ASSAULT_AFFRAY
  DOMESTIC_VIOLENCE_DOWRY
  PUBLIC_NUISANCE
  MISSING_PERSON
  NARCOTICS_DRUGS_INFO
  HARASSMENT_STALKING
  MOTOR_VEHICLE_DISPUTE
  CORRUPTION_VIGILANCE
  OTHER_GENERAL
}

enum ComplaintPriority {
  ROUTINE
  URGENT
  CRITICAL_SENSITIVE
  CM_WINDOW_VIP
}

enum ComplaintStatus {
  REGISTERED
  ASSIGNED_TO_EO
  ENQUIRY_IN_PROGRESS
  INTERIM_REPORT_SUBMITTED
  REPORT_SUBMITTED
  PENDING_SHO_REVIEW
  PENDING_DSP_REVIEW
  RECOMMENDED_FOR_FIR
  DISPOSED_MUTUAL_ACCORD
  DISPOSED_CIVIL_NATURE
  DISPOSED_UNSUBSTANTIATED
  TRANSFERRED_OTHER_PS
}

model Complaint {
  id                   String                       @id @default(cuid())
  complaintNumber      String                       @unique
  source               ComplaintSource              @default(WALK_IN_STATION)
  category             ComplaintCategory
  subCategory          String?
  priority             ComplaintPriority            @default(ROUTINE)
  status               ComplaintStatus              @default(REGISTERED)
  incidentDate         DateTime?
  incidentPlace        String
  incidentLandmark     String?
  incidentDetails      String                       @db.Text
  complainantName      String
  complainantFatherSpouse String?
  complainantGender    String
  complainantAge       Int?
  complainantMobile    String
  complainantAltPhone  String?
  complainantAadhaar   String?
  complainantAddress   String
  complainantCity      String
  complainantDistrict  String
  complainantState     String                       @default("Haryana")
  accusedDetails       Json?
  policeStationId      String
  policeStation        PoliceUnit                   @relation(fields: [policeStationId], references: [id])
  registeredById       String
  registeredBy         User                         @relation("RegisteredBy", fields: [registeredById], references: [id])
  assignedEoId         String?
  assignedEo           User?                        @relation("AssignedEO", fields: [assignedEoId], references: [id])
  assignedById         String?
  assignedBy           User?                        @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedAt           DateTime?
  targetResolutionDate DateTime?
  assignmentHistory    ComplaintAssignmentHistory[]
  enquiryActions       EnquiryActionLog[]
  evidences            ComplaintEvidence[]
  enquiryReports       EnquiryReport[]
  approvals            ApprovalHistory[]
  relatedGdEntries     GeneralDiaryEntry[]
  isSensitive          Boolean                      @default(false)
  isFIRRecommended     Boolean                      @default(false)
  recommendedFIRNumber String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([policeStationId])
  @@index([status])
  @@index([assignedEoId])
  @@index([complaintNumber])
}

model ComplaintAssignmentHistory {
  id               String    @id @default(cuid())
  complaintId      String
  complaint        Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  previousEoId     String?
  newEoId          String
  assignedById     String
  assignmentReason String?
  assignedAt       DateTime  @default(now())

  @@index([complaintId])
}

enum EnquiryActionType {
  SPOT_INSPECTION
  WITNESS_EXAMINATION
  COMPLAINANT_STATEMENT
  ACCUSED_EXAMINATION
  NOTICE_ISSUED_BNSS
  DOCUMENT_VERIFICATION
  CCTV_RETRIEVAL
  INTERIM_BRIEF
}

model EnquiryActionLog {
  id              String            @id @default(cuid())
  complaintId     String
  complaint       Complaint         @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  officerId       String
  officer         User              @relation(fields: [officerId], references: [id])
  actionType      EnquiryActionType
  actionDate      DateTime          @default(now())
  locationVisited String?
  personsExamined String?
  summaryOfAction String            @db.Text
  nextActionPlan  String?
  attachments     Json?
  createdAt       DateTime          @default(now())

  @@index([complaintId])
  @@index([officerId])
}

enum EvidenceType {
  COMPLAINT_COPY_SIGNED
  SPOT_PHOTOGRAPH
  CCTV_FOOTAGE_CLIP
  AUDIO_RECORDING
  BANK_FINANCIAL_STATEMENT
  MEDICAL_MLR_REPORT
  WRITTEN_STATEMENT
  NOTICE_COPY
  OTHER_DOCUMENT
}

model ComplaintEvidence {
  id             String       @id @default(cuid())
  complaintId    String
  complaint      Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  title          String
  evidenceType   EvidenceType
  fileUrl        String
  fileName       String
  fileSize       Int
  fileMimeType   String
  sha256Hash     String
  collectedAt    DateTime     @default(now())
  collectedPlace String?
  description    String?      @db.Text
  chainOfCustody String?      @db.Text
  uploadedById   String
  uploadedAt     DateTime     @default(now())

  @@index([complaintId])
  @@index([sha256Hash])
}

enum FinalRecommendation {
  REGISTER_FIR_COGNIZABLE
  DISPOSE_CIVIL_DISPUTE
  DISPOSE_MUTUAL_SETTLEMENT
  DISPOSE_FALSE_MALICIOUS
  TRANSFER_OTHER_JURISDICTION
  FURTHER_INVESTIGATION_NEEDED
}

model EnquiryReport {
  id                    String              @id @default(cuid())
  complaintId           String
  complaint             Complaint           @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  submittedById         String
  submittedBy           User                @relation(fields: [submittedById], references: [id])
  briefFacts            String              @db.Text
  enquiryConductSummary String              @db.Text
  keyFindings           String              @db.Text
  recommendation        FinalRecommendation
  proposedLegalSections String?
  detailedRemarks       String?             @db.Text
  isDraft               Boolean             @default(true)
  isApproved            Boolean             @default(false)
  submittedAt           DateTime            @default(now())
  approvals             ApprovalHistory[]

  @@index([complaintId])
}

enum ApprovalDecision {
  APPROVED
  RETURNED_WITH_QUERIES
  REJECTED
  ESCALATED_TO_SUPERVISOR
}

model ApprovalHistory {
  id              String           @id @default(cuid())
  reportId        String
  report          EnquiryReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  complaintId     String
  complaint       Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  approverId      String
  approver        User             @relation(fields: [approverId], references: [id])
  approverRole    SystemRole
  decision        ApprovalDecision
  officialRemarks String           @db.Text
  decisionDate    DateTime         @default(now())

  @@index([complaintId])
  @@index([reportId])
}

enum GDEntryType {
  OPENING_OF_DIARY
  SHIFT_RELIEF_TURNOVER
  OFFICER_DEPARTURE
  OFFICER_ARRIVAL
  PATROL_DEPARTURE_RETURN
  COMPLAINT_RECEIPT
  FIR_REGISTERED_ENTRY
  ARREST_INTIMATION
  SEIZURE_MUDDMAL
  SUPERVISORY_INSPECTION
  GOVERNMENT_PROPERTY_LOG
  CLOSING_OF_DIARY
  MISCELLANEOUS_EVENT
}

model GeneralDiaryEntry {
  id                 String              @id @default(cuid())
  gdNumber           String
  sequencePerDay     Int
  gdDate             DateTime
  entryTime          DateTime            @default(now())
  entryType          GDEntryType
  subject            String
  narrative          String              @db.Text
  policeStationId    String
  policeStation      PoliceUnit          @relation(fields: [policeStationId], references: [id])
  loggedById         String
  loggedBy           User                @relation("GDLogger", fields: [loggedById], references: [id])
  relatedComplaintId String?
  relatedComplaint   Complaint?          @relation(fields: [relatedComplaintId], references: [id])
  isLocked           Boolean             @default(true)
  isAddendum         Boolean             @default(false)
  parentGdEntryId    String?
  parentGdEntry      GeneralDiaryEntry?  @relation("GDAddendum", fields: [parentGdEntryId], references: [id])
  childAddendums     GeneralDiaryEntry[] @relation("GDAddendum")
  createdAt          DateTime            @default(now())

  @@unique([policeStationId, gdDate, sequencePerDay])
  @@index([policeStationId, gdDate])
  @@index([entryType])
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  RECORD_CREATE
  RECORD_UPDATE
  RECORD_VIEW_SENSITIVE
  EO_ASSIGNMENT
  EO_REASSIGNMENT
  ENQUIRY_REPORT_SUBMIT
  REPORT_APPROVED
  RECORD_TRANSFER
  DOCUMENT_DOWNLOAD
  GD_ENTRY_LOGGED
}

model AuditLog {
  id         String      @id @default(cuid())
  timestamp  DateTime    @default(now())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  userPno    String?
  userRole   SystemRole?
  action     AuditAction
  entityName String
  entityId   String
  ipAddress  String?
  userAgent  String?
  details    Json?

  @@index([entityName, entityId])
  @@index([userId])
  @@index([timestamp])
}
