datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PoliceUnit {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  type         String
  district     String
  range        String
  contactPhone String?
  email        String?
  address      String?
  parentId     String?
  parent       PoliceUnit?         @relation("UnitHierarchy", fields: [parentId], references: [id])
  subUnits     PoliceUnit[]        @relation("UnitHierarchy")
  officers     User[]
  complaints   Complaint[]
  gdEntries    GeneralDiaryEntry[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([district])
  @@index([type])
}

model User {
  id                 String              @id @default(cuid())
  pno                String              @unique
  beltNumber         String?
  fullName           String
  rank               String
  role               String
  status             String          @default("ACTIVE")
  mobileNumber       String              @unique
  email              String?             @unique
  passwordHash       String
  unitId             String
  unit               PoliceUnit          @relation(fields: [unitId], references: [id])
  assignedComplaints Complaint[]         @relation("AssignedEO")
  registeredComplaints Complaint[]       @relation("RegisteredBy")
  assignedByMe       Complaint[]         @relation("AssignedBy")
  enquiryActions     EnquiryActionLog[]
  submittedReports   EnquiryReport[]
  approvalDecisions  ApprovalHistory[]
  gdEntriesLogged    GeneralDiaryEntry[] @relation("GDLogger")
  auditLogs          AuditLog[]
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([unitId])
  @@index([role])
}

model Complaint {
  id                   String                       @id @default(cuid())
  complaintNumber      String                       @unique
  source               String              @default("WALK_IN_STATION")
  category             String
  subCategory          String?
  priority             String            @default("ROUTINE")
  status               String              @default("REGISTERED")
  incidentDate         DateTime?
  incidentPlace        String
  incidentLandmark     String?
  incidentDetails      String
  complainantName      String
  complainantFatherSpouse String?
  complainantGender    String
  complainantAge       Int?
  complainantMobile    String
  complainantAltPhone  String?
  complainantAadhaar   String?
  complainantAddress   String
  complainantCity      String
  complainantDistrict  String
  complainantState     String                       @default("Haryana")
  accusedDetails       String?
  policeStationId      String
  policeStation        PoliceUnit                   @relation(fields: [policeStationId], references: [id])
  registeredById       String
  registeredBy         User                         @relation("RegisteredBy", fields: [registeredById], references: [id])
  assignedEoId         String?
  assignedEo           User?                        @relation("AssignedEO", fields: [assignedEoId], references: [id])
  assignedById         String?
  assignedBy           User?                        @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedAt           DateTime?
  targetResolutionDate DateTime?
  assignmentHistory    ComplaintAssignmentHistory[]
  enquiryActions       EnquiryActionLog[]
  evidences            ComplaintEvidence[]
  enquiryReports       EnquiryReport[]
  approvals            ApprovalHistory[]
  relatedGdEntries     GeneralDiaryEntry[]
  isSensitive          Boolean                      @default(false)
  isFIRRecommended     Boolean                      @default(false)
  recommendedFIRNumber String?
  directSendToFir      Boolean                      @default(false)
  shoDecision          String?
  rejectionReason      String?
  rejectionAt          DateTime?
  rejectionBy          String?
  rejectionCount       Int                          @default(0)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([policeStationId])
  @@index([status])
  @@index([assignedEoId])
  @@index([complaintNumber])
}

model ComplaintAssignmentHistory {
  id               String    @id @default(cuid())
  complaintId      String
  complaint        Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  previousEoId     String?
  newEoId          String
  assignedById     String
  assignmentReason String?
  assignedAt       DateTime  @default(now())

  @@index([complaintId])
}

model EnquiryActionLog {
  id              String            @id @default(cuid())
  complaintId     String
  complaint       Complaint         @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  officerId       String
  officer         User              @relation(fields: [officerId], references: [id])
  actionType      String
  actionDate      DateTime          @default(now())
  locationVisited String?
  personsExamined String?
  summaryOfAction String
  nextActionPlan  String?
  attachments     String?
  createdAt       DateTime          @default(now())

  @@index([complaintId])
  @@index([officerId])
}

model ComplaintEvidence {
  id             String       @id @default(cuid())
  complaintId    String
  complaint      Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  title          String
  evidenceType   String
  fileUrl        String
  fileName       String
  fileSize       Int
  fileMimeType   String
  sha256Hash     String
  collectedAt    DateTime     @default(now())
  collectedPlace String?
  description    String?
  chainOfCustody String?
  uploadedById   String
  uploadedAt     DateTime     @default(now())

  @@index([complaintId])
  @@index([sha256Hash])
}

model EnquiryReport {
  id                    String              @id @default(cuid())
  complaintId           String
  complaint             Complaint           @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  submittedById         String
  submittedBy           User                @relation(fields: [submittedById], references: [id])
  briefFacts            String
  enquiryConductSummary String
  keyFindings           String
  recommendation        String
  proposedLegalSections String?
  detailedRemarks       String?
  isDraft               Boolean             @default(true)
  isApproved            Boolean             @default(false)
  submittedAt           DateTime            @default(now())
  approvals             ApprovalHistory[]

  @@index([complaintId])
}

model ApprovalHistory {
  id              String           @id @default(cuid())
  reportId        String
  report          EnquiryReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  complaintId     String
  complaint       Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  approverId      String
  approver        User             @relation(fields: [approverId], references: [id])
  approverRole    String
  decision        String
  officialRemarks String
  decisionDate    DateTime         @default(now())

  @@index([complaintId])
  @@index([reportId])
}

model GeneralDiaryEntry {
  id                 String              @id @default(cuid())
  gdNumber           String
  sequencePerDay     Int
  gdDate             DateTime
  entryTime          DateTime            @default(now())
  entryType          String
  subject            String
  narrative          String
  policeStationId    String
  policeStation      PoliceUnit          @relation(fields: [policeStationId], references: [id])
  loggedById         String
  loggedBy           User                @relation("GDLogger", fields: [loggedById], references: [id])
  relatedComplaintId String?
  relatedComplaint   Complaint?          @relation(fields: [relatedComplaintId], references: [id])
  isLocked           Boolean             @default(true)
  isAddendum         Boolean             @default(false)
  parentGdEntryId    String?
  parentGdEntry      GeneralDiaryEntry?  @relation("GDAddendum", fields: [parentGdEntryId], references: [id])
  childAddendums     GeneralDiaryEntry[] @relation("GDAddendum")
  createdAt          DateTime            @default(now())

  @@unique([policeStationId, gdDate, sequencePerDay])
  @@index([policeStationId, gdDate])
  @@index([entryType])
}

model AuditLog {
  id         String      @id @default(cuid())
  timestamp  DateTime    @default(now())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  userPno    String?
  userRole   String?
  action     String
  entityName String
  entityId   String
  ipAddress  String?
  userAgent  String?
  details    String?

  @@index([entityName, entityId])
  @@index([userId])
  @@index([timestamp])
}

model BuilderTemplate {
  id                String   @id @default(cuid())
  name              String
  description       String?
  content           String
  documentStructure String?
  customFields      String?
  createdBy         String
  createdByName     String?
  createdByRank     String?
  status            String   @default("ACTIVE")
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  drafts            BuilderDraft[]

  @@index([createdBy])
  @@index([status])
}

model BuilderDraft {
  id                String           @id @default(cuid())
  name              String
  description       String?
  content           String
  documentStructure String?
  customFields      String?
  caseId            String?
  complaintNumber   String?
  templateId        String?
  template          BuilderTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy         String
  createdByName     String?
  createdByRank     String?
  status            String           @default("DRAFT")
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([createdBy])
  @@index([caseId])
  @@index([templateId])
  @@index([status])
}

